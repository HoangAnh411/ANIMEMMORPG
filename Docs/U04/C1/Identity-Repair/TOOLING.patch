+    recovery_base=dict(role='BENIGN_METADATA_FAILURE_CHILD',executable=str(executable),binarySHA256=sha(executable),sourceSHA=NATIVE,runId=recovery_id,userDir=str(folder/'User'),log=str(folder/'unused.log'))
