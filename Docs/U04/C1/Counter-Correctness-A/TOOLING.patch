diff --git a/Scripts/U04/C1Counter.py b/Scripts/U04/C1Counter.py
new file mode 100644
index 0000000..ba69995
--- /dev/null
+++ b/Scripts/U04/C1Counter.py
@@ -0,0 +1,120 @@
+"""One-action counter diagnostic state machine. No OS operations at import."""
+import json
+from pathlib import Path
+from C1Readiness import Session
+from C1Run import sha, write
+
+
+class CounterSession(Session):
+    def __init__(self, *args, workload, output):
+        super().__init__(*args)
+        self.workload = workload
+        self.output = Path(output)
+        self.gameplay_edges = 0
+
+    def command(self, text):
+        w = self.workload
+        allowed = [f"u04c1 prepare {w['subjects']} {w['boxes']} {w['placement']}", 'u04c1 begin 5']
+        if text not in allowed:
+            self.fail('counter_command_forbidden')
+        self.j.append('counter_command_start', command=text)
+        self.tap('Console'); self.wait(.2)
+        for ch in text:
+            self.tap('CHAR:' + ch, .012)
+        self.tap('Enter'); self.wait(.25)
+        self.j.append('counter_command_sent', command=text)
+
+    def click_resume(self, x, y):
+        self.j.append('resume_click_start', purpose='Resume')
+        super().click_resume(x, y)
+        self.j.append('resume_click_end', purpose='Resume')
+
+    def gameplay_edge(self, down):
+        # Separate from Session.emit('LMB'), whose geometry checks are Resume-only.
+        # No cursor move, focus retry or release is permitted on this route.
+        if self.gameplay_edges != (0 if down else 1):
+            self.fail('counter_lmb_order_or_repeat')
+        self.guard('before_gameplay_lmb')
+        self.j.append('input_planned', key='LMB', down=down, purpose='counter-action')
+        if down:
+            self.held.add('LMB')
+        try:
+            sent = self.b.send('LMB', down)
+        except Exception as e:
+            self.fail('input_send_error:' + repr(e))
+        if sent != 1:
+            self.fail('input_short_send')
+        if not down:
+            self.held.discard('LMB')
+        self.gameplay_edges += 1
+        self.last_input = dict(key='LMB', down=down, monotonic=self.b.now(), purpose='counter-action')
+        self.j.append('input_sent', **self.last_input, held=sorted(self.held))
+        self.guard('after_gameplay_lmb')
+
+    def playing(self):
+        sample = self.fresh_metrics()
+        m = sample['metrics']
+        if m['controlState'] != 0 or m['windowActive'] is not True or m.get('motorLocked') or m.get('gateAttack') is not True:
+            self.fail('counter_not_playing')
+        if not m.get('combat', {}).get('pawnId'):
+            self.fail('counter_combat_identity_missing')
+        return sample
+
+    def capture(self):
+        readiness = self.setup()
+        before = self.playing()
+        if any(self.output.iterdir()):
+            self.fail('counter_output_not_empty_before_prepare')
+        w = self.workload
+        self.command(f"u04c1 prepare {w['subjects']} {w['boxes']} {w['placement']}")
+        self.wait(2)
+        prepared = self.playing()
+        if prepared['metrics']['combat']['pawnId'] != before['metrics']['combat']['pawnId'] or prepared['metrics']['combat']['life'] != before['metrics']['combat']['life']:
+            self.fail('counter_attacker_life_changed')
+        if any(self.output.iterdir()):
+            self.fail('counter_output_before_begin')
+        self.j.append('counter_empty_output_before_begin')
+        self.command('u04c1 begin 5')
+        self.guard('counter_before_action')
+        input_offset = self.log.size()
+        self.j.append('counter_action_log_boundary', offset=input_offset)
+        self.gameplay_edge(True); self.wait(.035); self.gameplay_edge(False)
+        # No console/input while the native five-second capture is active.
+        self.wait(5)
+        deadline = self.b.now() + 5
+        while True:
+            self.guard('counter_export_poll')
+            files = [self.output / name for name in ('summary.json', 'frames.csv')]
+            try:
+                json.loads(files[0].read_text(encoding='utf-8-sig'))
+                complete = files[1].read_bytes().endswith(b'\n')
+            except (OSError, ValueError):
+                complete = False
+            if complete:
+                break
+            if self.b.now() >= deadline:
+                self.fail('counter_summary_or_frames_timeout')
+            self.wait(.05)
+        after = self.playing()
+        receipt = dict(readiness=readiness, before=before, prepared=prepared, after=after,
+                       files={p.name: sha(p) for p in files}, process=self.record,
+                       workload=w, outputWasEmpty=True, inputOffset=input_offset, inputEndOffset=self.log.size())
+        self.j.append('counter_capture_complete', receipt=receipt)
+        return receipt
+
+
+def run_counter_probe(record, backend, log, journal, cleanup=False):
+    if cleanup:
+        raise RuntimeError('outer_original_handle_lifecycle_required')
+    s = CounterSession(record, backend, log, journal, workload=record['workload'], output=record['raw'])
+    try:
+        receipt = s.capture()
+        write(Path(record['raw']).parent / 'capture.json', receipt)
+        from C1Validate import validate
+        result = validate(Path(record['raw']).parent, single=True, require_stop=False)
+        journal.append('counter_validation', validation=result)
+        return result
+    except Exception as e:
+        s.failed = True
+        journal.append('counter_invalid', error=repr(e), held=sorted(s.held), lastInput=s.last_input)
+        return dict(status='INVALID', error=repr(e), held=sorted(s.held), lastInput=s.last_input)
diff --git a/Scripts/U04/C1CounterRun.py b/Scripts/U04/C1CounterRun.py
new file mode 100644
index 0000000..198378b
--- /dev/null
+++ b/Scripts/U04/C1CounterRun.py
@@ -0,0 +1,71 @@
+"""Dedicated Build-03 counter correctness entry; one process, one action, no trace.
+
+CC-A authorizes fake-backend execution only. Live use needs separate CC-B approval.
+"""
+import argparse
+import re
+import subprocess
+from pathlib import Path
+from C1Run import ROOT, NATIVE, arguments, read, write, sha, run_owned_launch
+from C1Counter import run_counter_probe
+
+GAME_SHA = '282fcefc5156be5f5aa81caf2bc3a764949f2eaf76de081f9c62aa0e2e54e5a5'
+
+
+def parse_args(argv=None):
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--build', type=Path, required=True)
+    p.add_argument('--id', required=True)
+    p.add_argument('--subjects', type=int, choices=[1, 10, 40], required=True)
+    p.add_argument('--boxes', type=int, choices=[1, 3], required=True)
+    p.add_argument('--placement', choices=['in', 'out'], required=True)
+    a = p.parse_args(argv)
+    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_-]{0,79}', a.id):
+        p.error('unsafe run ID')
+    return a
+
+
+def main(argv=None):
+    a = parse_args(argv)
+    build = a.build.resolve()
+    if build != ROOT.parent / 'Runs/Build-03':
+        raise RuntimeError('only Build-03 is allowed')
+    out = ROOT.parent / 'Runs' / a.id
+    if out.exists():
+        raise RuntimeError('run ID already used; no reuse or replacement')
+    index = read(build / 'BUILD-IDENTITY.json')
+    if index['sourceSHA'] != NATIVE or Path(index['clone']).resolve() != ROOT:
+        raise RuntimeError('build source mismatch')
+    if subprocess.check_output(['git', '-C', str(ROOT), 'diff', NATIVE, '--', 'Source', 'Content', 'Config', 'Plugins', 'AnimeMMORPG.uproject']):
+        raise RuntimeError('native inputs changed')
+    exe = build / 'Archive/Windows/AnimeMMORPG/Binaries/Win64/AnimeMMORPG.exe'
+    if index['gameSHA256'] != GAME_SHA or sha(exe) != GAME_SHA:
+        raise RuntimeError('Build-03 Game hash mismatch')
+    from C1Win32 import Backend
+    backend = Backend()
+    protected = backend.inventory()
+    if any(Path(p['ExecutablePath']).name.lower() == 'animemmorpg.exe' for p in protected):
+        raise RuntimeError('package already active')
+    out.mkdir(exist_ok=False)
+    for name in ('User', 'Raw'):
+        (out / name).mkdir()
+    workload = dict(subjects=a.subjects, boxes=a.boxes, placement=a.placement)
+    args = arguments(exe, out, a.id)
+    write(out / 'protected-before.json', protected)
+    write(out / 'command.json', dict(arguments=args, purpose='counter-correctness', trace='off', actions=1,
+                                    workload=workload, dpi=backend.dpi))
+    base = dict(role='U04C1Counter', executable=str(exe), binarySHA256=GAME_SHA, sourceSHA=NATIVE,
+                runId=a.id, userDir=str(out / 'User'), log=str(out / 'Game.log'), raw=str(out / 'Raw'), workload=workload)
+    result = run_owned_launch(backend, args, exe.parent, out, base, probe=run_counter_probe)
+    try:
+        after = backend.inventory(); write(out / 'protected-after.json', after)
+        if not all(p in after for p in protected):
+            result.update(status='INVALID', protectedIdentityChanged=True)
+    except Exception as e:
+        result.update(status='INVALID', protectedInventoryError=repr(e))
+    write(out / 'final.json', result)
+    return 0 if result['status'] == 'PASS' else 1
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
